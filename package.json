{
  "name": "@smwyylc/dsh-work-diary",
  "description": "DSH Web GUI 每日日记插件：侧栏「日记」面板，按天汇总当天所有会话，生成中文 Markdown 总结；支持定时自动执行与手动生成，总结模型可配置。",
  "version": "0.1.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/smwyylc/dsh-work-diary.git"
  },
  "homepage": "https://github.com/smwyylc/dsh-work-diary",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "dsh",
    "work-diary",
    "daily-summary",
    "web-ui"
  ],
  "engines": {
    "dsh": ">=0.2.0-rc.2 <0.3.0-0"
  },
  "type": "module",
  "main": "lib/index.js",
  "scripts": {
    "test": "node --test"
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": []
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "icon.svg",
    "README.md",
    "README.zh.md",
    "README.i18n.yaml",
    "LICENSE"
  ],
  "license": "MIT"
}
